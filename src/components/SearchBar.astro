---
// Barra de busca estilo "página inicial de navegador".
// Sem JS: envia pro Google (form GET). Com JS: sugestões ao digitar (via
// /api/suggest, proxy do Google Suggest na VPS) e URL digitada vai direto.
---

<section class="startbar" aria-label="Busca rápida">
  <div class="container startbar-inner">
    <div class="searchwrap">
      <form id="gsearch" class="searchbox" action="https://www.google.com/search" method="get" role="search" target="_top">
        <svg class="search-ic" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          id="gq"
          type="search"
          name="q"
          placeholder="Pesquisar no Google ou digitar um endereço"
          aria-label="Pesquisar no Google"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="search"
          role="combobox"
          aria-expanded="false"
          aria-controls="gsug"
        />
        <button type="submit" class="search-go" aria-label="Pesquisar">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>
      <ul id="gsug" class="gsug" role="listbox" hidden></ul>
    </div>

    <nav class="quicklinks" aria-label="Atalhos">
      <a href="https://mail.google.com" target="_top">Gmail</a>
      <a href="https://youtube.com" target="_top">YouTube</a>
      <a href="https://wa.me/" target="_top">WhatsApp</a>
      <a href="/becape/restrito">Anotações</a>
      <a href="/becape">BECAPE</a>
    </nav>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById('gsearch');
    var q = document.getElementById('gq');
    var sug = document.getElementById('gsug');
    if (!form || !q || !sug) return;

    /* ---- URL direta vs busca ---- */
    form.addEventListener('submit', function (e) {
      closeSug();
      var v = q.value.trim();
      if (!v) { e.preventDefault(); q.focus(); return; }
      if (/^https?:\/\//i.test(v)) { e.preventDefault(); window.top.location.href = v; return; }
      if (!/\s/.test(v) && /^[^\s]+\.[a-z]{2,}(\/.*)?$/i.test(v)) {
        e.preventDefault(); window.top.location.href = 'https://' + v; return;
      }
    });

    /* ---- sugestões ---- */
    var timer = null, ctrl = null, active = -1, typed = '';

    function closeSug() {
      sug.hidden = true; sug.innerHTML = ''; active = -1;
      q.setAttribute('aria-expanded', 'false');
    }
    function items() { return sug.querySelectorAll('li'); }

    function render(list) {
      if (!list || !list.length) { closeSug(); return; }
      sug.innerHTML = '';
      list.forEach(function (s) {
        var li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.innerHTML = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>';
        var span = document.createElement('span');
        span.textContent = s;
        li.appendChild(span);
        // pointerdown dispara antes do blur do input
        li.addEventListener('pointerdown', function (e) {
          e.preventDefault();
          q.value = s;
          closeSug();
          form.requestSubmit();
        });
        sug.appendChild(li);
      });
      sug.hidden = false; active = -1;
      q.setAttribute('aria-expanded', 'true');
    }

    function highlight() {
      var els = items();
      els.forEach(function (el, i) { el.classList.toggle('on', i === active); });
      q.value = active >= 0 ? els[active].textContent.trim() : typed;
    }

    q.addEventListener('input', function () {
      typed = q.value;
      clearTimeout(timer);
      var v = q.value.trim();
      if (!v) { closeSug(); return; }
      timer = setTimeout(function () {
        if (ctrl) ctrl.abort();
        ctrl = ('AbortController' in window) ? new AbortController() : null;
        fetch('/api/suggest?q=' + encodeURIComponent(v), ctrl ? { signal: ctrl.signal } : {})
          .then(function (r) { return r.ok ? r.json() : { s: [] }; })
          .then(function (d) { if (q.value.trim() === v) render(d.s); })
          .catch(function () {});
      }, 180);
    });

    q.addEventListener('keydown', function (e) {
      if (sug.hidden) return;
      var n = items().length;
      if (e.key === 'ArrowDown') { e.preventDefault(); active = (active + 1) % n; highlight(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); active = active <= 0 ? n - 1 : active - 1; highlight(); }
      else if (e.key === 'Escape') { closeSug(); q.value = typed; }
    });

    q.addEventListener('blur', function () { setTimeout(closeSug, 150); });
  })();
</script>

<style is:global>
  .startbar {
    padding-block: clamp(var(--space-6), 7vw, var(--space-8)) var(--space-5);
  }
  .startbar-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .searchwrap {
    position: relative;
    width: 100%;
    max-width: 42rem;
  }
  .searchbox {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.5rem 0.35rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .searchbox:focus-within {
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
  }
  .search-ic { color: var(--ink-soft); flex: none; }
  #gq {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: 1.05rem; /* >=16px evita zoom no iOS/mobile */
    padding: 0.75rem 0;
    color: var(--ink);
  }
  #gq::placeholder { color: var(--ink-muted); }
  #gq:focus { outline: none; }
  #gq::-webkit-search-decoration,
  #gq::-webkit-search-cancel-button { -webkit-appearance: none; }

  .search-go {
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--ink);
    color: var(--surface);
    transition: background var(--dur-fast) var(--ease);
  }
  .search-go:hover { background: var(--accent); }

  /* dropdown de sugestões */
  .gsug {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 40;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    padding-block: 0.35rem;
  }
  .gsug li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 1.1rem;
    cursor: pointer;
    color: var(--ink);
    font-size: 1rem;
  }
  .gsug li svg { color: var(--ink-muted); flex: none; }
  .gsug li span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gsug li:hover,
  .gsug li.on { background: var(--surface-2); }

  .quicklinks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.9rem;
  }
  .quicklinks a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .quicklinks a:hover { background: var(--surface-2); color: var(--accent); }

  @media (max-width: 640px) {
    .searchbox { padding-left: 0.9rem; }
    #gq { font-size: 1rem; padding-block: 0.7rem; }
    .gsug li { padding: 0.75rem 1rem; }
  }
</style>
