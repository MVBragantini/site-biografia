---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="foot-brand">{site.name}</p>
      <p class="foot-tag">{site.role}</p>
    </div>

    <div class="foot-col">
      <h4>Navegação</h4>
      <ul>
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="foot-col">
      <h4>Contato</h4>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href={site.github} target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>
  </div>

  <div class="container foot-bottom">
    <span>© {year} {site.name}</span>
    <span class="foot-views" hidden aria-label="Visitas ao site" title="Visitas ao site">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
      <span id="bv-views">—</span>
    </span>
    <span class="foot-meta">{site.location}</span>
  </div>
</footer>

<script is:inline>
  fetch('/api/views', { credentials: 'same-origin' })
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      if (!d || typeof d.total !== 'number') return;
      const el = document.getElementById('bv-views');
      const wrap = document.querySelector('.foot-views');
      if (!el || !wrap) return;
      el.textContent = d.total.toLocaleString('pt-BR');
      wrap.hidden = false;
    })
    .catch(() => {});
</script>

<style>
  .site-footer {
    margin-top: var(--space-9);
    padding-block: var(--space-7) var(--space-5);
    background: var(--surface-2);
    border-top: 1px solid var(--border);
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .foot-brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--ink);
  }
  .foot-tag {
    margin-top: var(--space-1);
    color: var(--ink-soft);
  }
  .foot-col h4 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }
  .foot-col ul { display: flex; flex-direction: column; gap: var(--space-2); }
  .foot-col a { color: var(--ink-2); transition: color var(--dur) var(--ease); }
  .foot-col a:hover { color: var(--accent); }
  .foot-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .foot-views {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-soft);
  }
  .foot-views svg { opacity: 0.8; }
  .foot-meta { margin-left: auto; }
  @media (max-width: 480px) {
    .foot-bottom { flex-wrap: wrap; }
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
