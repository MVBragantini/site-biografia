---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
---

<Base title={`Anotações — ${site.name}`} noindex={true}>
  <link rel="stylesheet" href="/vendor/quill/quill.snow.css" />
  <section class="section">
    <div class="container">
      <p id="rz-loading" class="rz-muted">Carregando…</p>

      <!-- LOGIN -->
      <div id="rz-login" class="rz-panel" hidden>
        <header class="rz-head">
          <span class="eyebrow">/becape/restrito</span>
          <h1>Anotações <span aria-hidden="true">🔒</span></h1>
        </header>
        <form id="rz-login-form" autocomplete="off">
          <label for="rz-pass">Senha</label>
          <input id="rz-pass" type="password" autocomplete="current-password" placeholder="Digite a senha" required />
          <button type="submit" class="rz-btn rz-btn-primary">Entrar</button>
          <p id="rz-login-error" class="rz-err" role="alert" hidden></p>
        </form>
      </div>

      <!-- LISTA -->
      <div id="rz-list" hidden>
        <div class="rz-topbar">
          <h1 class="rz-title">Anotações</h1>
          <div class="rz-topbar-actions">
            <button id="rz-new" class="rz-btn rz-btn-primary">＋ Nova</button>
            <button id="rz-logout" class="rz-btn rz-link">Sair</button>
          </div>
        </div>
        <div id="rz-sort" class="rz-sort" hidden>
          <span>Ordenar:</span>
          <button data-sort="updated" class="rz-sort-btn on">recentes</button>
          <button data-sort="title" class="rz-sort-btn">título</button>
        </div>
        <p id="rz-empty" class="rz-muted" hidden>Nenhuma anotação ainda. Toque em <b>＋ Nova</b> para começar.</p>
        <div id="rz-cards" class="rz-cards"></div>
      </div>

      <!-- EDITOR -->
      <div id="rz-editor" hidden>
        <div class="rz-topbar">
          <button id="rz-back" class="rz-btn rz-link">← Anotações</button>
          <div class="rz-topbar-actions">
            <span id="rz-status" class="rz-status"></span>
            <button id="rz-share" class="rz-btn rz-link">Compartilhar</button>
            <button id="rz-del" class="rz-btn rz-link rz-danger">Excluir</button>
          </div>
        </div>

        <div id="rz-share-panel" class="rz-share-panel" hidden>
          <div class="rz-share-row">
            <input id="rz-share-url" type="text" readonly onclick="this.select()" />
            <button id="rz-share-copy" class="rz-btn rz-btn-primary">Copiar</button>
          </div>
          <div class="rz-share-foot">
            <span class="rz-muted">🌐 Qualquer pessoa com o link vê esta nota (somente leitura).</span>
            <button id="rz-share-stop" class="rz-btn rz-link rz-danger">Parar de compartilhar</button>
          </div>
        </div>

        <textarea id="rz-note-title" class="rz-note-title" rows="1" placeholder="Título da anotação"></textarea>
        <div id="rz-quill"></div>

        <div id="rz-table-tools" class="rz-table-tools">
          <button data-act="insert" class="rz-tt-btn">▦ Inserir tabela</button>
          <span id="rz-tt-when" hidden>
            <button data-act="rowBelow" class="rz-tt-btn">+ linha</button>
            <button data-act="colRight" class="rz-tt-btn">+ coluna</button>
            <button data-act="delRow" class="rz-tt-btn">− linha</button>
            <button data-act="delCol" class="rz-tt-btn">− coluna</button>
            <button data-act="delTable" class="rz-tt-btn rz-danger">excluir tabela</button>
          </span>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline src="/vendor/quill/quill.js"></script>
<script is:inline>
  (function () {
    const $ = (id) => document.getElementById(id);
    const api = (p, opts) => fetch('/api/restrito' + p, Object.assign({ credentials: 'same-origin' }, opts));
    const V = { loading: $('rz-loading'), login: $('rz-login'), list: $('rz-list'), editor: $('rz-editor') };
    function show(v) { for (const k in V) V[k].hidden = k !== v; }
    function fmtDate(ms) { try { return new Date(ms).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' }); } catch { return ''; } }
    function autoGrow(el) { el.style.height = 'auto'; el.style.height = el.scrollHeight + 'px'; }

    /* ---------- LISTA ---------- */
    let allNotas = [], sortBy = 'updated';
    async function loadList() {
      const r = await api('/notas');
      if (r.status === 401) { show('login'); return; }
      allNotas = (await r.json()).notas || [];
      renderList();
      show('list');
    }
    function renderList() {
      const box = $('rz-cards'); box.innerHTML = '';
      $('rz-empty').hidden = allNotas.length > 0;
      $('rz-sort').hidden = allNotas.length < 2;
      const arr = allNotas.slice().sort((a, b) =>
        sortBy === 'title' ? (a.title || '').localeCompare(b.title || '', 'pt') : (b.updated - a.updated));
      for (const n of arr) {
        const card = document.createElement('button'); card.className = 'rz-note-card';
        const t = document.createElement('span'); t.className = 'rz-nc-title'; t.textContent = n.title || 'Sem título';
        const s = document.createElement('span'); s.className = 'rz-nc-snip'; s.textContent = n.snippet || '';
        const d = document.createElement('span'); d.className = 'rz-nc-date'; d.textContent = fmtDate(n.updated);
        card.append(t, s, d);
        card.addEventListener('click', () => openEditor(n.id));
        box.appendChild(card);
      }
    }
    $('rz-sort').querySelectorAll('.rz-sort-btn').forEach((b) =>
      b.addEventListener('click', () => {
        sortBy = b.dataset.sort;
        $('rz-sort').querySelectorAll('.rz-sort-btn').forEach((x) => x.classList.toggle('on', x === b));
        renderList();
      }));

    /* ---------- EDITOR (Quill) ---------- */
    let quill = null, state = { id: null, title: '' };
    let saving = false, pendingSave = false, saveTimer = null, loadingNote = false;

    function ensureQuill() {
      if (quill) return;
      quill = new Quill('#rz-quill', {
        theme: 'snow',
        placeholder: 'Escreva sua anotação…',
        modules: {
          table: true,
          toolbar: {
            container: [
              [{ header: [1, 2, 3, false] }],
              ['bold', 'italic', 'underline', 'strike'],
              [{ color: [] }, { background: [] }],
              [{ list: 'ordered' }, { list: 'bullet' }, { list: 'check' }],
              [{ align: [] }],
              ['link', 'image'],
              ['clean'],
            ],
            handlers: { image: imageHandler },
          },
        },
      });
      quill.on('text-change', (d, o, source) => { if (source === 'user' && !loadingNote) scheduleSave(); });
      quill.on('selection-change', (range) => {
        let inTable = false;
        if (range) { try { inTable = !!quill.getModule('table').getTable(range)[0]; } catch (e) {} }
        $('rz-tt-when').hidden = !inTable;
      });
    }

    // controles de tabela
    $('rz-table-tools').addEventListener('click', (e) => {
      const b = e.target.closest('button'); if (!b || !quill) return;
      const t = quill.getModule('table'); const act = b.dataset.act;
      quill.focus(); quill.getSelection(true);
      try {
        if (act === 'insert') t.insertTable(3, 3);
        else if (act === 'rowBelow') t.insertRowBelow();
        else if (act === 'colRight') t.insertColumnRight();
        else if (act === 'delRow') t.deleteRow();
        else if (act === 'delCol') t.deleteColumn();
        else if (act === 'delTable') t.deleteTable();
      } catch (err) {}
      scheduleSave();
    });

    function imageHandler() {
      const input = document.createElement('input'); input.type = 'file'; input.accept = 'image/*';
      input.onchange = async () => {
        const file = input.files && input.files[0]; if (!file) return;
        const range = quill.getSelection(true);
        setStatus('enviando imagem…');
        try {
          const r = await api('/nota-img?name=' + encodeURIComponent(file.name), { method: 'POST', headers: { 'Content-Type': file.type || 'image/jpeg' }, body: file });
          const d = await r.json().catch(() => ({}));
          if (r.ok && d.url) { quill.insertEmbed(range.index, 'image', d.url, 'user'); quill.setSelection(range.index + 1, 0); }
          else setStatus('erro: ' + (d.error || 'upload'));
        } catch { setStatus('falha no upload'); }
      };
      input.click();
    }

    function setStatus(t) { $('rz-status').textContent = t; }
    function scheduleSave() { setStatus('editando…'); clearTimeout(saveTimer); saveTimer = setTimeout(saveNote, 900); }
    async function saveNote() {
      if (saving) { pendingSave = true; return; }
      saving = true; setStatus('salvando…');
      const payload = { id: state.id, title: state.title, content: quill.getContents(), text: quill.getText() };
      try {
        const r = await api('/nota', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (r.ok) { const n = await r.json(); state.id = n.id; setStatus('salvo ✓'); }
        else setStatus('erro ao salvar');
      } catch { setStatus('sem conexão'); }
      saving = false;
      if (pendingSave) { pendingSave = false; saveNote(); }
    }

    async function openEditor(id) {
      ensureQuill();
      loadingNote = true;
      if (id) {
        const r = await api('/nota/' + encodeURIComponent(id));
        if (!r.ok) { loadingNote = false; alert('Não consegui abrir a nota.'); return; }
        const n = await r.json();
        state = { id: n.id, title: n.title || '', share: n.share || null };
        if (n.content && n.content.ops) quill.setContents(n.content); else quill.setText('');
      } else {
        state = { id: null, title: '', share: null };
        quill.setText('');
      }
      $('rz-note-title').value = state.title;
      setStatus(state.id ? 'salvo ✓' : '');
      $('rz-share-panel').hidden = true;
      updateShareUI();
      show('editor');
      autoGrow($('rz-note-title'));
      loadingNote = false;
      if (!id) $('rz-note-title').focus();
    }

    /* ---------- COMPARTILHAR ---------- */
    function shareUrl(token) { return location.origin + '/becape/nota?n=' + token; }
    function updateShareUI() {
      const on = !!(state.share && state.share.enabled && state.share.token);
      $('rz-share').textContent = on ? '🌐 Compartilhada' : 'Compartilhar';
      $('rz-share').classList.toggle('rz-on', on);
      if (on) $('rz-share-url').value = shareUrl(state.share.token);
    }
    async function setShare(enabled) {
      if (!state.id) { await saveNote(); }
      if (!state.id) return null;
      const r = await api('/nota/share', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: state.id, enabled }) });
      if (!r.ok) return null;
      const d = await r.json();
      state.share = { enabled: d.enabled, token: d.token };
      updateShareUI();
      return d;
    }
    $('rz-share').addEventListener('click', async () => {
      const panel = $('rz-share-panel');
      if (state.share && state.share.enabled) { panel.hidden = !panel.hidden; return; }
      setStatus('gerando link…');
      const d = await setShare(true);
      setStatus(state.id ? 'salvo ✓' : '');
      if (d) panel.hidden = false;
    });
    $('rz-share-copy').addEventListener('click', async () => {
      const url = $('rz-share-url').value;
      try { await navigator.clipboard.writeText(url); }
      catch { $('rz-share-url').select(); try { document.execCommand('copy'); } catch (e) {} }
      const b = $('rz-share-copy'); b.textContent = 'Copiado!'; setTimeout(() => (b.textContent = 'Copiar'), 1500);
    });
    $('rz-share-stop').addEventListener('click', async () => {
      await setShare(false);
      $('rz-share-panel').hidden = true;
    });

    $('rz-note-title').addEventListener('input', (e) => { state.title = e.target.value; autoGrow(e.target); scheduleSave(); });
    $('rz-new').addEventListener('click', () => openEditor(null));
    $('rz-back').addEventListener('click', async () => { clearTimeout(saveTimer); await saveNote(); loadList(); });
    $('rz-del').addEventListener('click', async () => {
      if (!confirm('Excluir esta anotação? Não dá pra desfazer.')) return;
      if (state.id) await api('/nota/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: state.id }) });
      loadList();
    });
    $('rz-logout').addEventListener('click', async () => { await api('/logout', { method: 'POST' }); show('login'); });

    /* ---------- LOGIN ---------- */
    $('rz-login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = $('rz-login-error'); err.hidden = true;
      const r = await api('/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: $('rz-pass').value }) });
      if (r.ok) { $('rz-pass').value = ''; loadList(); }
      else { const d = await r.json().catch(() => ({})); err.textContent = d.error || 'Não foi possível entrar.'; err.hidden = false; }
    });

    /* ---------- BOOT ---------- */
    (async () => {
      try { const r = await api('/session'); (await r.json()).authed ? loadList() : show('login'); }
      catch { show('login'); }
    })();
  })();
</script>

<style is:global>
  .rz-muted { color: var(--ink-soft); }
  .rz-head { margin-bottom: var(--space-5); }
  .rz-head h1 { font-size: var(--step-4); margin-top: var(--space-2); }

  .rz-panel { max-width: 24rem; padding: var(--space-6); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  #rz-login-form { display: flex; flex-direction: column; gap: var(--space-3); }
  #rz-login-form label { font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-soft); }
  #rz-pass { padding: 0.7rem 0.9rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); font-size: 1rem; }
  #rz-pass:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }

  .rz-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.55rem 0.95rem; border-radius: var(--radius); font-weight: 500; cursor: pointer; transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease); }
  .rz-btn-primary { background: var(--ink); color: var(--surface); }
  .rz-btn-primary:hover { background: var(--accent); }
  .rz-link { color: var(--ink-soft); }
  .rz-link:hover { color: var(--accent); }
  .rz-danger:hover { color: var(--danger); }

  .rz-topbar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-4); flex-wrap: wrap; }
  .rz-topbar .rz-title { font-size: var(--step-4); }
  .rz-topbar-actions { display: flex; align-items: center; gap: var(--space-3); }
  .rz-status { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-muted); min-width: 5rem; text-align: right; }

  .rz-sort { display: flex; align-items: center; gap: 0.5rem; margin-bottom: var(--space-4); font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-muted); }
  .rz-sort-btn { padding: 0.2rem 0.6rem; border: 1px solid var(--border); border-radius: var(--radius-full); color: var(--ink-soft); }
  .rz-sort-btn.on { background: var(--ink); color: var(--surface); border-color: var(--ink); }

  .rz-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: var(--space-4); }
  .rz-note-card { display: flex; flex-direction: column; gap: 0.35rem; text-align: left; padding: var(--space-4); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .rz-note-card:hover { border-color: var(--ink-2); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .rz-nc-title { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); color: var(--ink); }
  .rz-nc-snip { color: var(--ink-2); font-size: var(--step--1); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .rz-nc-date { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-muted); margin-top: auto; }

  .rz-note-title { width: 100%; border: 0; background: transparent; resize: none; overflow: hidden; font-family: var(--font-display); font-weight: 700; font-size: var(--step-4); line-height: 1.15; color: var(--ink); margin-bottom: var(--space-3); }
  .rz-note-title:focus { outline: none; }
  .rz-err { color: var(--danger); font-size: var(--step--1); }

  /* Quill integrado ao tema do site */
  #rz-quill { background: var(--surface); border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
  .ql-toolbar.ql-snow { border-color: var(--border); border-radius: var(--radius-lg) var(--radius-lg) 0 0; background: var(--surface-2); position: sticky; top: 0; z-index: 5; }
  .ql-container.ql-snow { border-color: var(--border); border-radius: 0 0 var(--radius-lg) var(--radius-lg); font-family: var(--font-sans); }
  .ql-editor { min-height: 55vh; font-size: 1rem; line-height: 1.6; color: var(--ink); }
  .ql-editor.ql-blank::before { color: var(--ink-muted); font-style: normal; }
  .ql-snow .ql-stroke { stroke: var(--ink-2); }
  .ql-snow .ql-fill { fill: var(--ink-2); }
  .ql-snow .ql-picker { color: var(--ink-2); }
  .ql-snow.ql-toolbar button:hover .ql-stroke, .ql-snow .ql-toolbar button:hover .ql-stroke { stroke: var(--accent); }
  .ql-snow.ql-toolbar button.ql-active .ql-stroke { stroke: var(--accent); }
  .ql-snow.ql-toolbar button.ql-active .ql-fill { fill: var(--accent); }
  .ql-editor img { border-radius: var(--radius); }
  .ql-editor table { border-collapse: collapse; width: 100%; margin: 0.6rem 0; }
  .ql-editor td { border: 1px solid var(--border); padding: 0.4rem 0.55rem; min-width: 2.5rem; vertical-align: top; }

  #rz-share.rz-on { color: var(--success); }
  .rz-share-panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-3); margin-bottom: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2); }
  .rz-share-row { display: flex; gap: var(--space-2); }
  #rz-share-url { flex: 1; min-width: 0; padding: 0.5rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-2); }
  .rz-share-foot { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap; font-size: var(--step--1); }

  .rz-table-tools { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: var(--space-3); }
  #rz-tt-when { display: inline-flex; flex-wrap: wrap; gap: 0.4rem; }
  .rz-tt-btn { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-soft); padding: 0.3rem 0.6rem; border: 1px solid var(--border); border-radius: var(--radius-full); }
  .rz-tt-btn:hover { border-color: var(--accent); color: var(--accent); }
  .rz-tt-btn.rz-danger:hover { border-color: var(--danger); color: var(--danger); }

  @media (max-width: 640px) {
    .rz-cards { grid-template-columns: 1fr; }
    .rz-note-title { font-size: var(--step-3); }
    .ql-editor { min-height: 60vh; }
  }
</style>
